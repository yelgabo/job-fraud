generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employer {
  id             String                 @id @default(cuid())
  nameNormalized String                 @unique
  nameDisplay    String
  website        String?
  applicationUrl String?
  addressRaw     String?
  checks         Json                   @default("{}")
  checkedAt      DateTime?
  jobs           Job[]
  webSearchLogs  EmployerWebSearchLog[]
}

// Raw audit trail of the Claude web_search activity behind each employer verification.
// Append-only: one row per verifyEmployerWeb run (a --rejudge adds a new row, giving history).
// Kept OUT of Employer.checks so prod pages (which read checks on every render) never pull these
// large encrypted_content blobs; consumed only by a separate, non-prod audit UI.
model EmployerWebSearchLog {
  id         String   @id @default(cuid())
  employerId String
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  capturedAt DateTime @default(now())
  queries    Json // string[] — the searches Claude ran (quick-scan convenience)
  blocks     Json // raw server_tool_use(web_search) + web_search_tool_result blocks, incl. encrypted_content

  @@index([employerId, capturedAt])
}

model Job {
  workbcId          String       @id
  employerId        String?
  employer          Employer?    @relation(fields: [employerId], references: [id], onDelete: SetNull)
  title             String
  location          String?
  salary            String?
  // Raw posted date as the producer wrote it (ISO prefix from the JSON API, free text from the
  // HTML fallback). Kept verbatim because the judge prompt shows it to the model.
  postedAt          String?
  // `postedAt` parsed into a real date, or null when it is missing/ambiguous/junk. Indexed: this
  // is what the site's `?posted=` window filter compares against. Populated at scrape time and by
  // `npm run backfill-posted-date`; parser in lib/shared/posted-date.ts. Never compare postedAt
  // strings instead.
  postedDate        DateTime?
  sourceUrl         String
  descriptionMd     String
  externalApplyUrl  String?
  externalApplyHost String?
  atsProvider       String?
  externalApplyOk   Boolean?
  applicationFlags  Json         @default("[]")
  // NOC occupation classification (from WorkBC) + derived coarse job-type bucket for filtering
  // and analysis. nocCode/nocGroup are kept raw so finer breakdowns stay possible.
  nocCode           String?
  nocGroup          String?
  category          String?
  // Scoring fields are null until the `judge` phase evaluates the posting.
  fraudScore        Int?
  riskBand          String?
  reasoning         String?
  signals           Json?
  // When the current verdict was last published, by any writer: a judgment, a recompute or a
  // republish. Null while PENDING. Not a review date; see judgedAt.
  scoredAt          DateTime?
  // When a judgment last produced this posting's verdict: a judge run on either path, or an
  // impersonation check. Recompose, recheck and republish leave it alone, and a send-back keeps it,
  // so it is the date the site shows as "Reviewed on". Filled from scoredAt on 2026-11-08 for older
  // rows, which for rows recomposed before then is the recompose date.
  judgedAt          DateTime?
  // Raw Jev text judgments the composer consumed, kept so a reweight (`npm run recompose`)
  // never needs inference. Null on rows scored before the composer, and on rows composed
  // without a TYPESAFE_API_KEY.
  judgments         Json?
  // Which era produced fraudScore: null = a model chose the number (pre-composer, or the
  // deterministic impersonation write), 1 = composed from the weight table. Analysis across
  // time must filter on this rather than guess.
  scoringVersion    Int?
  // Whether the site shows the posting. Moves with scoredAt (PUBLISHED iff scoredAt is set), and
  // only lib/scoring/write-verdict.ts writes it.
  status            JobStatus    @default(PENDING)
  // How the current verdict was produced, kept while a rerun sends the row back to PENDING. Null
  // until the first verdict. Replaces reading meaning out of scoringVersion = null and the
  // "Brand impersonation:" reasoning prefix.
  verdictKind       VerdictKind?
  scrapedAt         DateTime     @default(now())
  // When a scrape last fetched this posting's detail (scrapedAt is set on insert only). The weekly
  // scrape refetches postings not fetched for a while, so edits on WorkBC reach the row. Null on
  // rows not fetched since the column was added (2026-11-09).
  fetchedAt         DateTime?

  @@index([riskBand, fraudScore])
  // Matches POSTINGS_ORDER_BY, so the unfiltered list reads its page in index order instead of
  // sorting every judged row.
  @@index([fraudScore(sort: Desc), title, workbcId])
  @@index([scoredAt])
  // Lets the whole-corpus counts and the band group-by skip the wide rows (index-only scan).
  @@index([scoredAt, riskBand])
  @@index([status, riskBand])
  @@index([category])
  @@index([postedDate])
}

// Owner comments on a posting, shown only on the token-gated /audit admin mirror. Append-only.
model ReviewNote {
  id        String   @id @default(cuid())
  workbcId  String
  body      String
  createdAt DateTime @default(now())

  @@index([workbcId, createdAt])
}

// Owner flags asking for a posting to be re-evaluated. kind "rerun" = normal re-judge on the
// next update (scoredAt is cleared immediately when the flag is created); kind "deep" = queued
// for a per-posting agent investigation, with `note` passed to the agent as owner context.
// resolvedAt is stamped by the update run that services the request.
model JudgeRequest {
  id         String    @id @default(cuid())
  workbcId   String
  kind       String // "rerun" | "deep"
  note       String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt, createdAt])
}

// One row per judge run on either path. Before this, a run's outcome existed only in cron status
// and stdout, so a run that judged nothing looked like a successful one (2026-11, 730 postings
// pending for over a week). Written by lib/shared/judge-run.ts.
model JudgeRun {
  id             String          @id @default(cuid())
  path           JudgePath
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?
  outcome        JudgeRunOutcome @default(RUNNING)
  pendingAtStart Int
  scored         Int             @default(0)
  held           Int             @default(0)
  failed         Int             @default(0)
  note           String?

  @@index([startedAt])
}

// One row per scrape run. Before this a run that fetched nothing (every detail request failing)
// exited 0 and looked like a quiet week. Written by lib/shared/scrape-run.ts.
model ScrapeRun {
  id         String           @id @default(cuid())
  startedAt  DateTime         @default(now())
  finishedAt DateTime?
  outcome    ScrapeRunOutcome @default(RUNNING)
  // The command-line arguments, so a --recent pass and a full sweep can be told apart.
  args       String
  listed     Int              @default(0)
  toFetch    Int              @default(0)
  written    Int              @default(0)
  sentBack   Int              @default(0)
  failed     Int              @default(0)
  note       String?

  @@index([startedAt])
}

// FAILED: the search found nothing, every detail fetch failed, or the process threw. PARTIAL:
// some detail fetches failed. RUNNING with no finishedAt: still running, or killed.
enum ScrapeRunOutcome {
  RUNNING
  OK
  PARTIAL
  FAILED
}

// A decided brand-impersonation check for one claimed employer and ATS tenant pair (the key is
// impersonationKey). Before this, a cleared answer lasted one process, so a posting that returned
// to pending, or a new posting from the same pair, paid for another Opus check, and the two judge
// paths could not see each other's answers. `verdict` is an ImpersonationSchema object.
model ImpersonationAnswer {
  key       String   @id
  verdict   Json
  decidedAt DateTime @default(now())
}

enum JudgePath {
  API
  KEYLESS
}

// FAILED: postings were pending and none was scored. PARTIAL: some were held back or failed.
// ABORTED: a billing or authentication error stopped the run. RUNNING with no finishedAt: the
// process died mid-run.
enum JudgeRunOutcome {
  RUNNING
  OK
  PARTIAL
  FAILED
  ABORTED
}

enum JobStatus {
  PENDING
  PUBLISHED
}

// MODEL: a model chose the number (before the composer). COMPOSED: the composer derived it from
// stored judgments and checks, so recompose can redo it. IMPERSONATION: the fixed 90 written by
// lib/ai/resolve-impersonation.ts, which the composer must never replace.
enum VerdictKind {
  MODEL
  COMPOSED
  IMPERSONATION
}
