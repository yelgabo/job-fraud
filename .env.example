# Postgres connection string. For local runs use Railway's DATABASE_PUBLIC_URL
# (TCP proxy host), not the *.railway.internal URL which only resolves inside Railway.
DATABASE_URL="postgresql://user:password@host:port/dbname"

# Anthropic API key. Only the keyed judge path needs it: `npm run judge` and the
# `rescore-failed` / `reverify-mail` / `rescan-impersonation` / `compare-judge` helpers.
# `npm run scrape`, the keyless `judge:fetch` -> agents -> `judge:apply` path, and `next build`
# never read it. Leave this commented out unless you have a real key: `lib/env.ts` only checks
# that the value is non-empty, so a placeholder passes validation, routes the run down the keyed
# path, and every Anthropic call then fails 401. A 401 is not a billing error, so the run does not
# abort; each posting is written with a failed verdict and a `scoredAt` timestamp, which means it
# looks judged and stops showing as pending.
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional: WorkBC search URL (defaults to software jobs, pagesize 50).
WORKBC_SEARCH_URL="https://www.workbc.ca/search-and-prepare-job/find-jobs#/job-search;search=software;pagesize=50;"

# Optional: polite User-Agent for Nominatim geocoding (ToS requires a real contact).
NOMINATIM_USER_AGENT="job-fraud/0.1 (github.com/yelnil)"
